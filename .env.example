# --- Сервер ---
PORT=3000
DB_PATH=./rsvp.db

# Доверие к заголовку X-Forwarded-For (для корректного rate-limit за прокси).
# false — нет прокси (по умолчанию); число — кол-во прокси-хопов (напр. 1 за nginx).
TRUST_PROXY=false

# Токен для просмотра ответов через /api/admin/rsvp?token=...
ADMIN_TOKEN=придумайте-длинный-секретный-токен

# --- Почта (SMTP) ---
# Если не заполнять SMTP_HOST — письма не отправляются, ответы пишутся только в базу.
# Пример для Яндекс.Почты:
#   SMTP_HOST=smtp.yandex.ru   SMTP_PORT=465   SMTP_SECURE=true
# Пример для Gmail (нужен пароль приложения):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@example.com
SMTP_PASS=your-app-password

# От кого и кому слать уведомления о новых ответах
MAIL_FROM=your@example.com
MAIL_TO=your@example.com
